{
  "manifest_version": 3,
  "name": "Acquisition Lens",
  "version": "0.2.0",
  "description": "Capture business listing figures, review source evidence, and screen deals privately on your device.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "Review a business listing" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'" }
}
