{
  "name": "small-business-acquisition-analyzer",
  "version": "0.3.0",
  "private": true,
  "description": "A local-first educational workspace for screening small business acquisitions.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai-evals": "vitest run lib/ai/__tests__",
    "test:coverage": "vitest run --coverage",
    "prebuild": "npm run build:extension && npm run build:notices",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "build:notices": "node scripts/build-notices.mjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@react-pdf/renderer": "4.3.1",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^3.4.6",
    "postcss": "8.5.33",
    "autoprefixer": "^10.4.19",
    "vitest": "^2.0.4",
    "@vitest/coverage-v8": "^2.0.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.29",
    "esbuild": "0.21.5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    },
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2"
  }
}
